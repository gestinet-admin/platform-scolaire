# Environnement
FLASK_ENV=development
FLASK_APP=wsgi.py

# Sécurité
SECRET_KEY=change-this-to-a-random-secure-key
JWT_SECRET_KEY=change-this-to-a-random-jwt-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/platform_scolaire_dev

# Établissement (pour installation simple)
ETABLISSEMENT_ID=1
ETABLISSEMENT_NOM=Écol​e Par Défaut

# JWT Token Expiration (en heures)
JWT_ACCESS_TOKEN_EXPIRES=1
JWT_REFRESH_TOKEN_EXPIRES=720  # 30 jours

# CORS
CORS_ORIGINS=*

# SMS Orange (Phase 2)
# ORANGE_SMS_API_KEY=your_api_key
# ORANGE_SMS_API_SECRET=your_api_secret
# ORANGE_SMS_NUMERO=+227XXXXXXXX

# Email SMTP (Phase 2)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Logs
LOG_LEVEL=INFO
LOG_FILE=app.log

# Offline Queue (Phase 2)
# OFFLINE_QUEUE_ENABLED=true
# OFFLINE_QUEUE_MAX_SIZE=1000
